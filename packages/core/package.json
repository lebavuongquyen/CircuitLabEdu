{
  "name": "@quyenlbv/core",
  "version": "0.1.2",
  "description": "Framework-independent circuit model validation and electrical simulation engine for CircuitLabEdu",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./solver": {
      "types": "./src/solver.d.ts",
      "import": "./src/solver.js"
    },
    "./transient": {
      "types": "./src/transient.d.ts",
      "import": "./src/transient.js"
    },
    "./wire-router": {
      "types": "./src/wire-router.d.ts",
      "import": "./src/wire-router.js"
    },
    "./viewport": {
      "types": "./src/viewport.d.ts",
      "import": "./src/viewport.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
